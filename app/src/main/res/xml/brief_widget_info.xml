<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件元数据。

  几个字段的取值理由：
  - updatePeriodMillis="0"：**不用系统定时刷新**。本应用的刷新完全由"用户点击"驱动，
    设成 0 可以彻底避免系统每 30 分钟唤醒一次进程（省电，也省得在 Doze 下被拖出来）。
  - previewImage 用的是用同一套点阵算法离线渲染出来的真实效果图
    （drawable-nodpi/widget_preview.png），不是默认图标 ——
    这样在系统的小组件选择器里看到的就是桌面上的样子。
    注意没有配 previewLayout：布局里那张点阵图是运行时由 RemoteViews 塞进去的，
    直接用布局当预览会是一块空白。
  - targetCellWidth/Height=3：给 Android 12+ 的桌面一个默认占位建议，
    minWidth/minHeight 保留给老版本（110dp ≈ 2 格，可自由 resize）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_brief"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
