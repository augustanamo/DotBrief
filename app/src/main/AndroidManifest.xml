<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：调用 LLM / 拉取 RSS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 日程读取（未来 24h 事件） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- 天气：只要"在哪个城市"，所以申请粗定位就够。
         有意**不申请** FINE_LOCATION / 后台定位 —— 天气用不到那么准的位置，
         多要一档权限只会让用户在授权弹窗前犹豫。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 点一下小组件给一次短震（约 18ms 的"收到"回执）。
         这是 normal 权限，装机即授予，不会弹窗；也不需要读取系统的触感设置 ——
         我们走的是 Vibrator 的直调，不是 View 的 haptic feedback。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- TTS 前台服务 + 播放中不被打断 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 定时播报（当闹钟用）：要精确到点，而且要在锁屏 / Doze 下也响得起来。
         两个都声明是有意的：
           - USE_EXACT_ALARM（API 33+）装机即授予、用户撤不掉 —— "到点出声"是这个
             应用的核心功能，不该让用户为了让它准点响再去翻一层系统设置；
           - SCHEDULE_EXACT_ALARM（API 31+）管低版本、以及用户在系统设置里动过的场景。
             代码里每次都查 canScheduleExactAlarms()，没拿到就降级到 WorkManager
             （仍会响，只是可能晚几分钟）。
         ⚠️ USE_EXACT_ALARM 受 Google Play 政策限制（仅限闹钟 / 日历类应用）。
            本应用自用分发、不在其管辖范围；**将来若要上架，这一条必须重新评估**。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 桌面小组件刷新 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 通知监听需要用户手动在系统设置里授权，无法运行时弹窗申请；
         android.permission.BIND_NOTIFICATION_LISTENER_SERVICE 由 Service 自己声明 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".BriefWidgetApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BriefWidget">

        <!-- ===== 配置中心（桌面图标入口）===== -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== 桌面小组件 ===== -->
        <receiver
            android:name=".widget.BriefWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 覆盖安装后必须补推一份 RemoteViews：system_server 里缓存的那份不会自动失效，
                     否则桌面会一直拿旧版 RemoteViews 去 apply，报「无法添加微件」 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/brief_widget_info" />
        </receiver>

        <!-- 定时播报的触发点。
             必须是**静态注册**：闹钟到点时应用进程多半不在（手机锁屏放了一夜），
             动态注册的接收器根本没人收得到 —— 那一刻连一行代码都跑不起来。
             收到后拉起前台服务出声，再把下一次排上。 -->
        <receiver
            android:name=".data.update.BriefAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 覆盖安装后重排定时播报。
             ⚠️ AlarmManager 的闹钟**不跨重启** —— WorkManager 自带的重启恢复没有了，
             这一棒得自己接。缺了它，重启一次定时播报就永久失效（直到用户手动开一次
             设置页），而"重启后闹钟不响"用户几乎不可能联想到是这里的问题。 -->
        <receiver
            android:name=".data.update.SchedulerRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 动画帧供给方：桌面通过 BIND_REMOTEVIEWS 权限访问，只暴露 adapter 数据 -->
        <service
            android:name=".widget.BriefWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- ===== 语音播报前台服务 ===== -->
        <service
            android:name=".tts.BriefPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
        ===== 通知监听：从航旅纵横 / 12306 / 菜鸟 等通知里提取车次、航班与取件码 =====
        必须由用户在「设置 -> 通知 -> 通知使用权」手动勾选，无法运行时弹窗申请。
        只有命中关键字的通知才会落库，其余一律丢弃。
        -->
        <service
            android:name=".data.notification.BriefNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
